#!/bin/bash
source "$(dirname "${BASH_SOURCE}")/_lib.sh"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
APPS_DIR="$PROJECT_ROOT/apps"
SKELS_DIR="$PROJECT_ROOT/skeletons"

APP_NAME=$1
shift
if [ -z "$APP_NAME" ]; then
    read -p "Enter the project name: " APP_NAME
fi
if [ -z "$APP_NAME" ]; then
    echo "Error: App name cannot be empty."
    exit 1
fi

APP_NAME=$(sanitize_app_name "$APP_NAME")
if [ $? -ne 0 ]; then
    exit 1
fi

APP_DIR="${APPS_DIR}/$APP_NAME"

if [ -d "$APP_DIR" ]; then
    echo "An app by that name already exists. Exiting to avoid overwriting: $APP_NAME"
    exit 1
fi

echo "New app: $APP_NAME"

echo "Select the project type for the app to clone"
SKEL_DIR_NAME=$(prompt_for_skeleton)
SKEL_DIR="${SKELS_DIR}/${SKEL_DIR_NAME}"

mkdir -p $APP_DIR
cp -r "$SKEL_DIR/." $APP_DIR

cd $APP_DIR || exit 1

git init

cat <<EOF >"README.md"
# $APP_NAME

## Description
TODO: Short description of what this app does.

## Requirements
TODO: List dependencies

## Usage
TODO: Describe how to use app
EOF

git add .
git commit -m "Initial commit from skeleton: $SKEL_DIR_NAME"

cd $PROJECT_ROOT
echo "Registering $APP_NAME as a submodule..."
git -C "$PROJECT_ROOT" submodule add "./apps/$APP_NAME" "apps/$APP_NAME"
git config -f .gitmodules submodule."$APP_DIR".ignore untracked

echo "Successfully initialized $APP_NAME"
