#!/bin/bash

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
APPS_DIR="$PROJECT_ROOT/apps"

ACTION="${1:-deploy}"
shift
APP_NAME="$1"
shift

IS_PURGE=false
for arg in "$@"; do
    [[ "$arg" == "--purge" ]] && IS_PURGE=true
done

mapfile -t APPS < <(find "$APPS_DIR" -maxdepth 1 -mindepth 1 -type d -not -path '*/.*' -printf "%f\n")

if [ -z "$APP_NAME" ]; then
    if command -v fzf >/dev/null 2>&1; then
        APP_NAME=$(printf "%s\n" "${APPS[@]}" | fzf --height 40% --reverse --header "Select App for [$ACTION]:")
    else
        PS3="Select an app (number): "
        select CHOICE in "${APPS[@]}"; do
            [[ -n "$CHOICE" ]] && APP_NAME="$CHOICE" && break
        done
    fi
fi

[[ -z "$APP_NAME" ]] && exit 1

APP_DIR="$APPS_DIR/$APP_NAME"
CONFIG_FILE="$APP_DIR/values.yaml"

EXTRA_VARS="app_name=$APP_NAME project_root=$PROJECT_ROOT"

case "$ACTION" in
    deploy)
        echo "Deploying app: $APP_NAME..."
        if [ -f "$CONFIG_FILE" ]; then
            yq -i '.enabled = true' "$CONFIG_FILE"
        fi
        ;;
    disable)
        echo "Disabling app: $APP_NAME..."
        touch "$CONFIG_FILE"
        yq -i '.enabled = false' "$CONFIG_FILE"
        git add "$CONFIG_FILE"
        ;;
    remove)
        EXTRA_VARS="$EXTRA_VARS app_state=absent"
        if [ "$IS_PURGE" = true ]; then
            echo "⚠️  Confirm PURGE of all data for app: '$APP_NAME'"
            read -p "WARNING: includes local files and cluster database data! (y/N): " confirm
            [[ "$confirm" != [yY] ]] && exit 1
            EXTRA_VARS="$EXTRA_VARS purge=true"
            echo "Purging app: $APP_NAME..."
        else
            read -p "⚠️  Confirm removal of all local files and deinit submodule for app: '$APP_NAME' (y/N): " confirm
            [[ "$confirm" != [yY] ]] && exit 1
            echo "Removing app: $APP_NAME..."
        fi
        ;;
esac

ansible-playbook "$PROJECT_ROOT/playbooks/deploy_app.yml" \
    -i "${PROJECT_ROOT}/inventory.yml" \
    -e "$EXTRA_VARS"

# local cleanup
if [[ $? -eq 0 && "$ACTION" == "remove" ]]; then
    echo "Fully removing $APP_NAME..."
    git submodule deinit -f "apps/$APP_NAME" 2>/dev/null
    git rm -f "apps/$APP_NAME" 2>/dev/null
    rm -rf "apps/$APP_NAME"
    rm -rf ".git/modules/apps/$APP_NAME"
    echo "Local files and Git references cleared."
fi
