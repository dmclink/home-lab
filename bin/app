#!/bin/bash

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
APPS_DIR="$PROJECT_ROOT/apps"

usage() {
    echo "Usage: app [command] [app_name]"
    echo ""
    echo "Commands:"
    echo "  deploy <name>     Initialize and deploy a new app"
    echo "  teardown <name>   Remove app from cluster and mark absent"
    echo "  db <name>      Open a psql tunnel to the app's database"
    echo "  list              List all apps in the apps/ directory"
    echo "  -h, --help        Show this help message"
}

COMMAND=$1
APP_NAME=$2

case $COMMAND in
    deploy)
        "$SCRIPT_DIR/deploy-app" "$APP_NAME"
        ;;
    teardown)
        if [ -z $APP_NAME ]; then echo "Error: name required"; exit 1; fi
        "$SCRIPT_DIR/teardown-app" "$APP_NAME"
        ;;
    db)
        "$SCRIPT_DIR/db-shell" "$APP_NAME"
        ;;
    list)
        ls "$APPS_DIR"
        ;;
    -h|--help|"")
        usage
        ;;
    *)
        echo "Unknown command: $COMMAND"
        usage
        exit 1
        ;;
esac
